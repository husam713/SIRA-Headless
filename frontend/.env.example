# ---------------------------------------------------------------------------
# Public hostname registry
# ---------------------------------------------------------------------------
# Extra hostnames are server configuration, not request input. Canonical
# production hosts remain hardcoded in src/config/sites.ts.
SIRA_EXTRA_HOSTS_JSON={"group":["group.localhost","group.staging.siratrgroup.com"],"consulting":["consulting.localhost","consulting.staging.siratrgroup.com"],"healthcare":["healthcare.localhost","healthcare.staging.siratrgroup.com"],"lifestyle":["lifestyle.localhost","lifestyle.staging.siratrgroup.com"],"realestate":["realestate.localhost","realestate.staging.siratrgroup.com"]}

# ---------------------------------------------------------------------------
# Server-only WordPress Multisite GraphQL registry
# ---------------------------------------------------------------------------
# Do not prefix any of these values with NEXT_PUBLIC_.
# Replace the .invalid examples with the actual WordPress endpoints.
SIRA_WP_GROUP_GRAPHQL_URL=https://wordpress.example.invalid/graphql
SIRA_WP_CONSULTING_GRAPHQL_URL=https://wordpress.example.invalid/consulting/graphql
SIRA_WP_HEALTHCARE_GRAPHQL_URL=https://wordpress.example.invalid/healthcare/graphql
SIRA_WP_LIFESTYLE_GRAPHQL_URL=https://wordpress.example.invalid/lifestyle/graphql
SIRA_WP_REALESTATE_GRAPHQL_URL=https://wordpress.example.invalid/realestate/graphql

SIRA_WP_GROUP_BLOG_ID=1
SIRA_WP_CONSULTING_BLOG_ID=2
SIRA_WP_HEALTHCARE_BLOG_ID=3
SIRA_WP_LIFESTYLE_BLOG_ID=4
SIRA_WP_REALESTATE_BLOG_ID=5

# GraphQL request behavior.
SIRA_GRAPHQL_TIMEOUT_MS=8000
SIRA_GRAPHQL_REVALIDATE_SECONDS=3600

# Reserved for Step 3 authenticated previews. Leave unset in Step 2B.
# SIRA_WP_PREVIEW_BEARER_TOKEN=

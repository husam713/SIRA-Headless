{
  "name": "sira-web",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:runtime-preview": "node scripts/preview-runtime-check.mjs",
    "check": "pnpm check:source",
    "schema:fetch": "node scripts/fetch-schema.mjs",
    "schema:check": "node scripts/check-schema.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "test:graphql": "vitest run tests/unit/graphql tests/contract",
    "check:source": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "check:graphql": "pnpm schema:check && pnpm codegen && pnpm typecheck && pnpm test:graphql",
    "test:brand": "vitest run tests/unit/brand tests/contract/brand-contract.test.ts tests/contract/design-runtime-exclusion.test.ts",
    "check:brand": "pnpm lint && pnpm typecheck && pnpm test:brand && pnpm build",
    "test:schema-compatibility": "vitest run tests/unit/schema-compatibility.test.ts",
    "check:schema-tooling": "pnpm lint && pnpm typecheck && pnpm test:schema-compatibility",
    "visual-diff": "node scripts/visual-diff.mjs",
    "verify:layout": "node scripts/verify-layout-primitives.mjs",
    "verify:alignment": "node scripts/verify-live-alignment.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "graphql": "16.14.2",
    "playwright-core": "1.62.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

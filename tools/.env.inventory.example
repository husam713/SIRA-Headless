# Use the same five server-only WPGraphQL endpoints as the approved Step 2B client.
SIRA_WP_GROUP_GRAPHQL_URL=https://wordpress.example.invalid/graphql
SIRA_WP_CONSULTING_GRAPHQL_URL=https://wordpress.example.invalid/consulting/graphql
SIRA_WP_HEALTHCARE_GRAPHQL_URL=https://wordpress.example.invalid/healthcare/graphql
SIRA_WP_LIFESTYLE_GRAPHQL_URL=https://wordpress.example.invalid/lifestyle/graphql
SIRA_WP_REALESTATE_GRAPHQL_URL=https://wordpress.example.invalid/realestate/graphql

# Optional. Set only in the shell when authenticated introspection is needed.
# SIRA_INVENTORY_AUTHORIZATION=Bearer REDACTED

# Optional output path.
# SIRA_INVENTORY_OUTPUT_DIR=/secure/path/step2c2a-output

# ---------------------------------------------------------------------------
# Deployment hostname registry
# ---------------------------------------------------------------------------
# Canonical production hosts and permanent redirect aliases remain hardcoded
# in src/config/sites.ts. Extra hosts are server configuration that map an
# environment hostname to a tenant without changing its production canonical
# hostname. They are not accepted from request input.
#
# The Group staging hostname is intentionally unresolved. Repository planning
# must use only the symbolic name GROUP_STAGING_HOST until a human confirms the
# real DNS hostname. Do not place GROUP_STAGING_HOST itself in this JSON because
# it is a symbolic label, not a valid DNS hostname. After confirmation, add the
# approved real hostname under "group" in the deployment environment only.
SIRA_EXTRA_HOSTS_JSON={"group":["group.localhost"],"consulting":["consulting.localhost"],"healthcare":["healthcare.localhost"],"lifestyle":["lifestyle.localhost"],"realestate":["realestate.localhost"],"digital":["digital.localhost"]}

# ---------------------------------------------------------------------------
# Search-engine discovery switch
# ---------------------------------------------------------------------------
# Discovery policy is otherwise decided purely by hostname role: a production
# canonical hostname is indexable by design. This switch exists so a tenant can
# be mapped to its real hostname and tested BEFORE its content is final without
# inviting crawlers in. While "off", every hostname — canonical included —
# serves noindex/nofollow metadata, "Disallow: /" in robots.txt and an empty
# sitemap. Releasing to search engines is then one environment change on the
# deployment, with no code deploy. Accepted values: on (default) | off.
# Anything else throws at request time rather than silently picking a side.
SIRA_SEARCH_INDEXING=on

# ---------------------------------------------------------------------------
# Server-only WordPress Multisite GraphQL registry
# ---------------------------------------------------------------------------
# Do not prefix any of these values with NEXT_PUBLIC_.
# Replace the .invalid examples with the actual WordPress endpoints.
#
# ADR-036 (2026-09-10): the CMS origin for every non-Group tenant is a dedicated
# `cms-<tenant>` subdomain, distinct from that tenant's public hostname, so the
# public subdomains are free for the frontend. Values are HTTPS-only.
# Group — blog 1, the network main site — stays on the network apex until the
# frontend production cutover; do not move its entry yet.
# Since 2026-09-18 (ADR-038) Group's origin is cms-group.siratrgroup.com, like the others.
SIRA_WP_GROUP_GRAPHQL_URL=https://wordpress.example.invalid/graphql
SIRA_WP_CONSULTING_GRAPHQL_URL=https://cms-consulting.example.invalid/graphql
SIRA_WP_HEALTHCARE_GRAPHQL_URL=https://cms-healthcare.example.invalid/graphql
SIRA_WP_LIFESTYLE_GRAPHQL_URL=https://cms-lifestyle.example.invalid/graphql
SIRA_WP_REALESTATE_GRAPHQL_URL=https://cms-realestate.example.invalid/graphql
SIRA_WP_DIGITAL_GRAPHQL_URL=https://cms-digital.example.invalid/graphql

SIRA_WP_GROUP_BLOG_ID=1
SIRA_WP_CONSULTING_BLOG_ID=2
SIRA_WP_HEALTHCARE_BLOG_ID=3
SIRA_WP_LIFESTYLE_BLOG_ID=4
SIRA_WP_REALESTATE_BLOG_ID=5
SIRA_WP_DIGITAL_BLOG_ID=6

# GraphQL request behavior.
SIRA_GRAPHQL_TIMEOUT_MS=8000
SIRA_GRAPHQL_REVALIDATE_SECONDS=3600

# ---------------------------------------------------------------------------
# Server-only editor preview API authentication
# ---------------------------------------------------------------------------
# Step 3C.1 selects WordPress Application Password + HTTP Basic authentication
# for Next.js Server -> WPGraphQL unpublished-content preview. Credentials are
# tenant-aware and must remain server-only. No live credential is currently
# configured by this repository increment. Do not commit real values.
#
# SIRA_WP_GROUP_PREVIEW_USERNAME=
# SIRA_WP_GROUP_PREVIEW_APPLICATION_PASSWORD=
# SIRA_WP_CONSULTING_PREVIEW_USERNAME=
# SIRA_WP_CONSULTING_PREVIEW_APPLICATION_PASSWORD=
# SIRA_WP_HEALTHCARE_PREVIEW_USERNAME=
# SIRA_WP_HEALTHCARE_PREVIEW_APPLICATION_PASSWORD=
# SIRA_WP_LIFESTYLE_PREVIEW_USERNAME=
# SIRA_WP_LIFESTYLE_PREVIEW_APPLICATION_PASSWORD=
# SIRA_WP_REALESTATE_PREVIEW_USERNAME=
# SIRA_WP_REALESTATE_PREVIEW_APPLICATION_PASSWORD=
# SIRA_WP_DIGITAL_PREVIEW_USERNAME=
# SIRA_WP_DIGITAL_PREVIEW_APPLICATION_PASSWORD=

# ---------------------------------------------------------------------------
# Server-only Preview Entry signing
# ---------------------------------------------------------------------------
# Dedicated Step 3C.2 HMAC secret shared only by the future sira-core signer
# and the Next.js verifier. Use separate values per environment. Never reuse
# WordPress Application Passwords, the revalidation HMAC secret, or future
# Investor Portal credentials. No live value is configured by this increment.
#
# SIRA_PREVIEW_ENTRY_SECRET=

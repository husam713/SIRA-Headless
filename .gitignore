# Environment secrets (example templates stay tracked)
.env*
!.env.example
!.env*.example

# Node.js / Next.js
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# PHP / Composer
vendor/
.phpunit.result.cache
.phpcs-cache

# WordPress runtime
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-config.php

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Operating system
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary archives
*.tmp
*.bak

# Local tooling / link state
.vercel/
.pnpm-store/
.claude/settings.local.json

# Backend packaging artifacts (kept on disk, backed up outside the repo)
backend/*.zip

# Homepage/Newsroom fidelity captures.
# The measurement JSON is small and worth versioning as evidence; the full-page
# PNGs are ~20MB per pass and are regenerated by
# frontend/scripts/measure-reference.mjs and measure-homepage.mjs.
artifacts/homepage-fidelity/**/*.png
artifacts/editorial/**/*.png
artifacts/branch-fidelity/**/*.png

# Introspection captures for `schema:fetch --offline`. Regenerated by
# tools/capture-schema-introspection.mjs; 31MB of derived JSON.
frontend/.schema-introspection/

# Responsive QA captures. Same rule as the fidelity passes above: the manifest
# is evidence, the 17MB of PNGs beside it are regenerated by the capture run.
artifacts/step-4/**/*.png

# Packaged evidence bundles. 63MB of zipped copies of files that are already
# either tracked individually or deliberately ignored; a zip in a pull request
# is reviewable by nobody.
artifacts/**/*.zip

# Chat transcripts kept beside the repository for convenience. They are working
# notes, not project state — `docs/` and `project-state.json` are the durable
# carriers — and they must never reach a commit.
conversation history*.txt

# Environment secrets (example templates stay tracked)
.env*
!.env.example
!.env*.example

# Node.js / Next.js
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# PHP / Composer
vendor/
.phpunit.result.cache
.phpcs-cache

# WordPress runtime
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-config.php

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Operating system
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary archives
*.tmp
*.bak

# Local tooling / link state
.vercel/
.pnpm-store/
.claude/settings.local.json

# Backend packaging artifacts (kept on disk, backed up outside the repo)
backend/*.zip
